# --- Web dashboard (`jarvis web`). Required if the site is reachable from other devices.
JARVIS_WEB_PASSWORD=
# JARVIS_SECRET=some-long-random-string   # keeps you logged in across restarts
# JARVIS_HTTPS=1                          # set when served over https (secure cookies)

# --- Brain ---
ANTHROPIC_API_KEY=sk-ant-...

# --- X / Twitter (developer.x.com, app with Read+Write) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# --- Bluesky (Settings > App Passwords) ---
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# --- Mastodon (Preferences > Development > New application) ---
MASTODON_API_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Facebook Page / Instagram Business (Meta Graph API) ---
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# --- YouTube: Google Cloud console > enable "YouTube Data API v3" > OAuth client (Desktop app)
# > download the JSON. Then run `jarvis youtube-auth` once.
YOUTUBE_CLIENT_SECRETS=client_secret.json

# --- Stock prices (free paper-trading account at alpaca.markets; used for market data only)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Telegram remote control (talk to Jarvis from your phone) ---
# Create a bot with @BotFather, then message it once and put your chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
